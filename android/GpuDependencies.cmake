# Android headers are staged separately so host libc headers never enter an NDK compile.
set(TEMPEST_ANDROID_HEADERS "" CACHE PATH "Staged architecture-independent renderer headers")
set(TEMPEST_ANDROID_SDL "" CACHE PATH "SDL3 Android install prefix")
foreach(header boost/version.hpp vulkan/vulkan.hpp tsl/robin_map.h vk_mem_alloc.h)
    if(NOT EXISTS "${TEMPEST_ANDROID_HEADERS}/include/${header}")
        message(FATAL_ERROR "Missing Android renderer header ${header}; stage TEMPEST_ANDROID_HEADERS")
    endif()
endforeach()
foreach(name Vulkan::Headers Boost::headers tsl::robin_map GPUOpen::VulkanMemoryAllocator)
    add_library(${name} INTERFACE IMPORTED)
    set_target_properties(${name} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${TEMPEST_ANDROID_HEADERS}/include")
endforeach()
add_library(Vulkan::Vulkan INTERFACE IMPORTED)
set_target_properties(Vulkan::Vulkan PROPERTIES INTERFACE_LINK_LIBRARIES vulkan)
find_package(SDL3 CONFIG REQUIRED PATHS "${TEMPEST_ANDROID_SDL}/lib/cmake/SDL3"
    NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
add_library(PkgConfig::SDL3 INTERFACE IMPORTED)
set_target_properties(PkgConfig::SDL3 PROPERTIES INTERFACE_LINK_LIBRARIES SDL3::SDL3)
# FEX's pinned xxhash source is already available in this embedding build.
add_library(tempest_android_xxhash STATIC "${CMAKE_SOURCE_DIR}/External/xxhash/xxhash.c")
target_include_directories(tempest_android_xxhash PUBLIC "${CMAKE_SOURCE_DIR}/External/xxhash")
add_library(PkgConfig::XXHASH ALIAS tempest_android_xxhash)
add_library(magic_enum::magic_enum INTERFACE IMPORTED)
set_target_properties(magic_enum::magic_enum PROPERTIES INTERFACE_INCLUDE_DIRECTORIES
    "${CMAKE_CURRENT_SOURCE_DIR}/third_party/magic_enum/include;${CMAKE_CURRENT_SOURCE_DIR}/third_party/magic_enum/include/magic_enum")
set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_FUZZERS OFF CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF)
add_subdirectory(third_party/miniz EXCLUDE_FROM_ALL)
add_library(miniz::miniz ALIAS miniz)
find_package(PkgConfig REQUIRED)
